== R in (p,q,c) ==
deg_p=3 deg_q=3 deg_c=3
Rpq = (2*c^3 + 4*c^2 + 2*c)*p^3 + ((4*c^3 + 10*c^2 + 8*c + 2)*q + (4*c^3 + 4*c^2 + c))*p^2 + ((2*c^3 + 8*c^2 + 10*c + 4)*q^2 + (4*c^3 + 4*c^2 + 2*c + 1)*q + (2*c^3 + c^2))*p + (2*c^2 + 4*c + 2)*q^3

-- terms of Rpq grouped by total (p,q)-degree --
  deg 1: (2*c^3 + c^2)*p
  deg 2: (4*c^3 + 4*c^2 + c)*p^2 + (4*c^3 + 4*c^2 + 2*c + 1)*q*p
  deg 3: (2*c^3 + 4*c^2 + 2*c)*p^3 + (4*c^3 + 10*c^2 + 8*c + 2)*q*p^2 + (2*c^3 + 8*c^2 + 10*c + 4)*q^2*p + (2*c^2 + 4*c + 2)*q^3

== c = -1/2 plane cubic in (p,q) ==
  -p^3 + (3*q^2 + 2*q)*p + 2*q^3  = 0
  value at (0,0): 0
  lowest-degree part at origin: 2*p*q  (nondegenerate quadratic => NODE)
  after p = m*q, dividing by q^2: (-m^3 + 3*m + 2)*q + 2*m
  => q(m) = 2*m/(m^3 - 3*m - 2) = Mat([m, 1]) / [m - 2, 1; m + 1, 2]
  => p(m) = 2*m^2/(m^3 - 3*m - 2)
  p^2-4q = (-4*m^4 + 24*m^2 + 16*m)/(m^6 - 6*m^4 - 4*m^3 + 9*m^2 + 12*m + 4)
     numerator   = [m, 1; m + 2, 1; m^2 - 2*m - 2, 1]
     denominator = [m - 2, 2; m + 1, 4]

