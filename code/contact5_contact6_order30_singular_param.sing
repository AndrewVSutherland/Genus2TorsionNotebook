LIB "paraplanecurves.lib";
ring R = 0,(U,S,Z),dp;
poly F =
U^10
+ 20*U^9*Z
+ 6*U^8*S*Z
+ 223*U^8*Z^2
+ 30*U^7*S*Z^2
- 21*U^6*S^2*Z^2
- 2*U^5*S^3*Z^2
+ 1380*U^7*Z^3
- 438*U^6*S*Z^3
- 60*U^5*S^2*Z^3
+ 34*U^4*S^3*Z^3
- 6*U^3*S^4*Z^3
+ 4005*U^6*Z^4
- 3525*U^5*S*Z^4
+ 1557*U^4*S^2*Z^4
- 488*U^3*S^3*Z^4
+ 105*U^2*S^4*Z^4
- 15*U*S^5*Z^4
+ S^6*Z^4
+ 2796*U^5*Z^5
- 2256*U^4*S*Z^5
+ 780*U^3*S^2*Z^5
- 150*U^2*S^3*Z^5
+ 12*U*S^4*Z^5
+ 767*U^4*Z^6
- 420*U^3*S*Z^6
+ 75*U^2*S^2*Z^6
- 4*U*S^3*Z^6
+ 70*U^3*Z^7
- 12*U^2*S*Z^7
- U^2*Z^8;
def P = paraPlaneCurve(F);
setring P;
PARA;
